# Copier ce fichier en .env puis adapter les valeurs.
DATABASE_URL=postgresql+psycopg://voyagecm_app:mot-de-passe@localhost:5432/voyagecm
# Base vidée à chaque lancement des tests (pytest)
TEST_DATABASE_URL=postgresql+psycopg://voyagecm_app:mot-de-passe@localhost:5432/voyagecm_test

# Clé de signature des jetons JWT : générer une valeur longue et aléatoire, par ex.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-moi
JWT_EXPIRE_MINUTES=480

# Compte administrateur créé par le script de données initiales (python -m app.seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi

# Mot de passe des comptes agences de démonstration (agency1, agency2, ...)
SEED_AGENCY_PASSWORD=change-moi

# Origines autorisées (séparées par des virgules) ; "*" pour le développement
CORS_ORIGINS=*
